{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=whatsapp.db"
  },
  "Api": {
    "TenantKeys": []
  },
  "Whatsapp": {
    "Client": {
      "MaxRetryAttempts": 2,
      "RetryBaseDelay": "00:00:00.500",
      "MaxInlineRetryDelay": "00:00:05",
      "RequestTimeout": "00:00:30"
    },
    "Outbox": {
      "DispatcherEnabled": true,
      "SchemaMode": "Auto",
      "PollInterval": "00:00:01",
      "BatchSize": 20,
      "Concurrency": 4,
      "MaxAttempts": 5,
      "LeaseDuration": "00:02:00",
      "RetryBaseDelay": "00:00:30",
      "RetryMaxDelay": "01:00:00"
    },
    "ConversationWindow": {
      "Duration": "1.00:00:00"
    },
    "Webhooks": {
      "MaxBodyBytes": 1048576
    },
    "Reconciliation": {
      "Enabled": true,
      "GracePeriod": "00:15:00",
      "PollInterval": "00:00:30",
      "OnGraceExpired": "DeadLetter",
      "BatchSize": 200
    },
    "Events": {
      "PreferFreeTextWithinWindow": false
    },
    "Tenants": {}
  }
}
