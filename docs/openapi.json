{
  "openapi": "3.1.1",
  "info": {
    "title": "WhatsApp Cloud Notifications API",
    "description": "Transactional WhatsApp notifications with an outbox, per-tenant credentials and service-window handling.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/notifications": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "summary": "Queues a custom notification for the tenant of the API key.",
        "description": "Returns 202 for a new notification and 200 with duplicate=true when the same (recipient, eventKey, referenceKey) was already queued.",
        "operationId": "EnqueueNotification",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnqueueNotificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnqueueNotificationResponse"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnqueueNotificationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "Lists notifications of all tenants, newest first (admin). Filters: status, recipient, tenantId, deliveryStatus.",
        "operationId": "ListNotifications",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/NotificationStatus"
            }
          },
          {
            "name": "recipient",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenantId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "deliveryStatus",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/DeliveryStatus"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/{id}": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "Returns one notification with its receipt timeline and derived delivery status. A tenant key only sees its own notifications.",
        "operationId": "GetNotification",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/{id}/retry": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "summary": "Requeues a Failed, DeadLettered or Unconfirmed notification with a fresh attempt budget (admin).",
        "description": "Retrying an Unconfirmed or unconfirmed-dead-lettered notification can deliver the message twice if the first request had in fact been accepted; check the provider first.",
        "operationId": "RetryNotification",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetryNotificationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events/booking-created": {
      "post": {
        "tags": [
          "Events"
        ],
        "summary": "Publishes a booking-created event. The notification is queued, never sent inline.",
        "description": "Re-posting the same event is safe: the notification is queued once per booking.",
        "operationId": "PublishBookingCreated",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingSnapshotRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events/booking-status-changed": {
      "post": {
        "tags": [
          "Events"
        ],
        "summary": "Publishes a booking-status-changed event. Ignored when the customer did not opt in.",
        "description": "Each (booking, status) pair is notified once.",
        "operationId": "PublishBookingStatusChanged",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingSnapshotRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/conversations/inbound": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "DEMO ONLY: simulates an inbound customer message, which opens the 24 hour service window.",
        "description": "Demo only. Real inbound messages arrive through the signed webhook (POST /api/v1/webhooks/whatsapp). This endpoint feeds the same recorder as the webhook, so it has exactly the same effect on the window.",
        "operationId": "SimulateInboundMessage",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InboundMessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InboundMessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/webhooks/whatsapp": {
      "get": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Webhook handshake: echoes hub.challenge when hub.verify_token matches a tenant\u0027s verify token.",
        "description": "Called by the provider when a webhook is subscribed. Authenticated by the verify token, not by an API key. 403 for a wrong token or mode.",
        "operationId": "VerifyWebhook",
        "parameters": [
          {
            "name": "hub.mode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hub.verify_token",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hub.challenge",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": []
      },
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Signed webhook delivery: inbound customer messages and delivery receipts.",
        "description": "Authenticated by X-Hub-Signature-256, the HMAC-SHA256 of the raw body with the tenant\u0027s app secret. The tenant is the one that owns metadata.phone_number_id. A delivery for an unknown phone number is acknowledged and ignored. Unknown fields and event types are skipped. Redeliveries change nothing.",
        "operationId": "ReceiveWebhook",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonElement"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "BookingDetailsInput": {
        "type": "object",
        "properties": {
          "checkInDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "departureAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "origin": {
            "type": [
              "null",
              "string"
            ]
          },
          "destination": {
            "type": [
              "null",
              "string"
            ]
          },
          "pickupAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "pickupLocation": {
            "type": [
              "null",
              "string"
            ]
          },
          "activityDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "BookingSnapshotRequest": {
        "required": [
          "bookingId",
          "reference",
          "customerFirstName",
          "phoneCountryCallingCode",
          "phoneNationalNumber",
          "bookingType",
          "status",
          "details",
          "companyName",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "customerFirstName": {
            "type": "string"
          },
          "phoneCountryCallingCode": {
            "type": "string"
          },
          "phoneNationalNumber": {
            "type": "string"
          },
          "bookingType": {
            "$ref": "#/components/schemas/BookingType"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "details": {
            "$ref": "#/components/schemas/BookingDetailsInput"
          },
          "companyName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "preferredLanguage": {
            "type": [
              "null",
              "string"
            ]
          },
          "whatsappUpdatesEnabled": {
            "type": "boolean"
          }
        }
      },
      "BookingStatus": {
        "enum": [
          "Confirmed",
          "TicketedOrVouchered",
          "PaymentCompleted",
          "ConfirmedPendingPayment",
          "CancellationPending",
          "Cancelled",
          "RefundProcessing",
          "RefundCompleted",
          "Updated"
        ]
      },
      "BookingType": {
        "enum": [
          "Hotel",
          "Flight",
          "Transfer",
          "Activity"
        ]
      },
      "DeliveryReceiptResponse": {
        "required": [
          "providerMessageId",
          "status",
          "occurredAt",
          "errorCode",
          "errorTitle"
        ],
        "type": "object",
        "properties": {
          "providerMessageId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "errorCode": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "errorTitle": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DeliveryStatus": {
        "enum": [
          "Sent",
          "Delivered",
          "Read",
          "Failed",
          null
        ]
      },
      "EnqueueNotificationRequest": {
        "required": [
          "recipient",
          "kind",
          "eventKey",
          "referenceKey"
        ],
        "type": "object",
        "properties": {
          "recipient": {
            "type": "string"
          },
          "defaultRegion": {
            "type": [
              "null",
              "string"
            ]
          },
          "kind": {
            "$ref": "#/components/schemas/NotificationKind"
          },
          "eventKey": {
            "type": "string"
          },
          "referenceKey": {
            "type": "string"
          },
          "template": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TemplateRequest"
              }
            ]
          },
          "text": {
            "type": [
              "null",
              "string"
            ]
          },
          "textVariants": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "placeholders": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "preferredLanguage": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "EnqueueNotificationResponse": {
        "required": [
          "id",
          "status",
          "duplicate"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/NotificationStatus"
          },
          "duplicate": {
            "type": "boolean"
          }
        }
      },
      "EventAcceptedResponse": {
        "required": [
          "eventKey",
          "referenceKey"
        ],
        "type": "object",
        "properties": {
          "eventKey": {
            "type": "string"
          },
          "referenceKey": {
            "type": "string"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "InboundMessageRequest": {
        "required": [
          "tenantId",
          "recipient"
        ],
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "recipient": {
            "type": "string"
          },
          "defaultRegion": {
            "type": [
              "null",
              "string"
            ]
          },
          "receivedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "InboundMessageResponse": {
        "required": [
          "tenantId",
          "recipient",
          "windowOpenUntil"
        ],
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "recipient": {
            "type": "string"
          },
          "windowOpenUntil": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "JsonElement": {},
      "NotificationKind": {
        "enum": [
          "Template",
          "FreeText"
        ]
      },
      "NotificationPageResponse": {
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationResponse"
            }
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "NotificationResponse": {
        "required": [
          "id",
          "tenantId",
          "recipient",
          "eventKey",
          "referenceKey",
          "kind",
          "status",
          "attempts",
          "nextAttemptAt",
          "templateName",
          "templateLanguage",
          "templateParameters",
          "text",
          "providerMessageId",
          "error",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string"
          },
          "recipient": {
            "type": "string"
          },
          "eventKey": {
            "type": "string"
          },
          "referenceKey": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/NotificationKind"
          },
          "status": {
            "$ref": "#/components/schemas/NotificationStatus"
          },
          "attempts": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "nextAttemptAt": {
            "type": "string",
            "format": "date-time"
          },
          "templateName": {
            "type": [
              "null",
              "string"
            ]
          },
